rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    // Public result data. Only an active Firebase staff account can write.
    match /athletics_2026_v1/data {
      allow read: if true;
      allow create, update, delete: if activeStaff();
    }

    // Existing Hodson's Run result store. It uses the same staff session.
    match /hodsons_production_v1/data {
      allow read: if true;
      allow create, update, delete: if activeStaff();
    }

    // Staff profiles are provisioned manually from the Firebase Console.
    // A signed-in user may read only their own profile. Clients can never
    // grant, revoke, or edit staff permissions.
    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Immutable audit trail for future administrative logging.
    match /athletics_2026_audit/{auditId} {
      allow read: if activeStaff();
      allow create: if activeStaff()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // No accidental access to new collections until they receive an explicit rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
